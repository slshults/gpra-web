{# In-app browser (WebView) escape.
   Meta's in-app browsers break scrolling on the landing page (~80% of FB ad
   sessions never scroll, per PostHog replay data, July 2026). We don't support
   in-app browsers at all: auto-escape to the device's default browser, and
   block the page with a centered modal prompt (dimmed backdrop, page visible
   above/below) so the in-app copy is never usable, while making it obvious
   the prompt can be dismissed.

   Escape schemes are an arms race with Meta, and Meta has beaten both
   programmatic routes (field data, 2026-07-06..09):
   - iOS FB app v568+ intercepts x-safari-https:// and opens ANOTHER internal
     browser view instead of Safari.
   - FB's Android WebView blocks intent:// even WITH a genuine user gesture
     (41 users fired gesture-driven escapes post-deploy; 1 reached a real
     browser — and that one was a non-FB WebView).
   So ALL Meta apps get manual "open in browser" instructions instead of a
   button. The tap/button escape remains for non-Meta WebViews, where the
   escape schemes still work (intent:// confirmed on Android). #}
<script>
(function () {
    'use strict';

    // Installed PWAs run in standalone display mode inside an OS web view —
    // on iOS the UA has no "Safari/" token, which would false-positive the
    // WebView detection below and lock installed-app users out. Bail first.
    if ((window.matchMedia && window.matchMedia('(display-mode: standalone)').matches) ||
        navigator.standalone === true) {
        return;
    }

    var ua = navigator.userAgent || '';

    // Meta apps (Facebook, Instagram, Messenger) tag their WebView UA.
    var isMetaApp = /FBAN|FBAV|FB_IAB|FB4A|FBIOS|Instagram|Messenger/i.test(ua);

    // Generic Android WebView carries a "wv" token real Chrome never has.
    var isAndroid = /Android/i.test(ua);
    var isAndroidWebView = isAndroid && /;\s*wv\)/.test(ua);

    // Generic iOS WebView: WebKit UA without "Safari/" (real Safari, CriOS,
    // FxiOS, and EdgiOS all include it; embedded WKWebViews don't).
    var isIOS = /iPhone|iPad|iPod/i.test(ua);
    var isIOSWebView = isIOS && /AppleWebKit/i.test(ua) && !/Safari\//i.test(ua);

    if (!(isMetaApp || isAndroidWebView || isIOSWebView)) return;

    var iabKind = isMetaApp ? 'meta' : (isAndroidWebView ? 'android_webview' : 'ios_webview');
    // Meta blocks both escape schemes (x-safari-https:// hijacked on iOS,
    // intent:// swallowed even with a gesture on Android), so a button that
    // fires them makes things worse — manual instructions instead.
    var metaManualOnly = isMetaApp;

    function captureEvent(name, props) {
        if (window.posthog && window.posthog.capture) {
            // send_instantly skips the batch queue; sendBeacon survives the
            // escape navigation freezing/killing this context moments later.
            window.posthog.capture(name, props, { send_instantly: true, transport: 'sendBeacon' });
        }
    }

    function escapeToBrowser() {
        // No location.hash here: a raw "#" would terminate the intent:// data
        // URI early. The iOS branch keeps the hash; Android loses it (the
        // fallback URL below still carries the full href).
        var pathQuery = location.pathname + location.search;
        if (isAndroid) {
            // intent:// hands the URL to Android's default https handler (a
            // real browser). If the WebView blocks the intent, the fallback
            // URL reloads this page in place — the sessionStorage guard below
            // keeps that from looping.
            location.href = 'intent://' + location.host + pathQuery +
                '#Intent;scheme=https;S.browser_fallback_url=' +
                encodeURIComponent(location.href) + ';end';
        } else if (isIOS) {
            // x-safari-https: opens the URL directly in Safari.
            location.href = 'x-safari-https://' + location.host + pathQuery + location.hash;
        } else {
            window.open(location.href, '_blank');
        }
    }

    function escapeWithCapture(trigger) {
        captureEvent('iab_escape_triggered', { iab_kind: iabKind, trigger: trigger });
        // Give the instant capture a beat to hit the network before the
        // navigation freezes this context. Chromium's transient user
        // activation survives a delay this short, so intent:// still counts
        // as gesture-driven.
        setTimeout(escapeToBrowser, 200);
    }

    function showOverlay() {
        if (document.getElementById('iab-escape-overlay')) return;

        // Backdrop: dims the page but leaves it visible above/below the
        // modal card, so it's obvious there's a dismissable prompt sitting
        // on top of a real page rather than a dead end.
        var overlay = document.createElement('div');
        overlay.id = 'iab-escape-overlay';
        overlay.setAttribute('role', 'alertdialog');
        overlay.setAttribute('aria-modal', 'true');
        overlay.setAttribute('aria-labelledby', 'iab-escape-message');
        overlay.style.cssText = 'position:fixed;inset:0;z-index:2147483647;' +
            'background:rgba(17,24,39,0.75);display:flex;' +
            'align-items:center;justify-content:center;padding:24px;' +
            'font-family:system-ui,-apple-system,sans-serif;';

        // Modal card: the actual prompt content, sized and centered so the
        // page shows around it on all sides.
        var modal = document.createElement('div');
        modal.style.cssText = 'position:relative;background:#111827;color:#d1d5db;' +
            'display:flex;flex-direction:column;align-items:center;text-align:center;' +
            'width:100%;max-width:360px;max-height:calc(100vh - 48px);overflow-y:auto;' +
            'padding:32px;border-radius:12px;' +
            'box-shadow:0 10px 40px rgba(0,0,0,0.5);';
        overlay.appendChild(modal);

        function dismissOverlay(trigger) {
            captureEvent('iab_escape_dismissed', { iab_kind: iabKind, trigger: trigger });
            // Persist the dismissal for this tab session: the cookie banner's
            // "Accept all" reloads the page, and without this flag the reload
            // would resurrect an overlay the user already dismissed.
            try { sessionStorage.setItem('iabOverlayDismissed', '1'); } catch (e) {}
            overlay.remove();
            document.body.style.overflow = '';
        }

        // Dismiss control — field feedback: when the escape fails AND the
        // instructions don't land, a hard-blocked page is a dead end. Let
        // users close the modal and take their chances with the IAB.
        var closeBtn = document.createElement('button');
        closeBtn.type = 'button';
        closeBtn.textContent = '×';
        closeBtn.setAttribute('aria-label', 'Dismiss');
        closeBtn.style.cssText = 'position:absolute;top:10px;right:10px;width:44px;height:44px;' +
            'border:0;border-radius:6px;background:transparent;color:#9ca3af;' +
            'font-size:30px;line-height:1;cursor:pointer;';
        closeBtn.addEventListener('click', function () {
            dismissOverlay('close_button');
        });
        modal.appendChild(closeBtn);

        var msg = document.createElement('p');
        msg.id = 'iab-escape-message';
        msg.style.cssText = 'font-size:18px;line-height:1.6;max-width:34ch;margin:0 0 28px;outline:none;';

        // Shared escape-hatch line: gpra.app 301s to the site, and is short
        // enough to retype in a real browser when all else fails. NOT a link
        // — a link would just open in yet another in-app view. Tapping it
        // copies the URL for pasting into a real browser instead.
        var fallbackNote = document.createElement('p');
        fallbackNote.style.cssText = 'font-size:15px;line-height:1.6;max-width:34ch;margin:24px 0 0;color:#9ca3af;';
        fallbackNote.appendChild(document.createTextNode("If that doesn't work, please open "));
        var fallbackCopy = document.createElement('button');
        fallbackCopy.type = 'button';
        fallbackCopy.textContent = 'gpra.app';
        fallbackCopy.setAttribute('aria-label', 'Copy gpra.app to clipboard');
        fallbackCopy.style.cssText = 'border:0;padding:0;background:transparent;cursor:pointer;' +
            'font:inherit;color:#f97316;text-decoration:underline;';
        fallbackCopy.addEventListener('click', function () {
            function confirmCopied() {
                fallbackCopy.textContent = 'gpra.app — copied!';
                fallbackCopy.style.textDecoration = 'none';
                setTimeout(function () {
                    fallbackCopy.textContent = 'gpra.app';
                    fallbackCopy.style.textDecoration = 'underline';
                }, 2000);
            }
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText('https://gpra.app').then(confirmCopied, function () {
                    // Clipboard denied (some WebViews) — nothing sensible to
                    // do; the text itself remains the instruction.
                });
            }
        });
        fallbackNote.appendChild(fallbackCopy);
        fallbackNote.appendChild(document.createTextNode(' in your default web browser'));

        if (metaManualOnly) {
            // Menu glyph and item label differ per platform: Android FB uses
            // a vertical ⋮ / "Open in external browser", iOS FB uses ⋯ /
            // "Open in system browser". Blank lines (pre-line + \n\n) break
            // the instructions into short scannable blocks for mobile users.
            msg.style.whiteSpace = 'pre-line';
            msg.textContent = isAndroid
                ? "Sorry, the app you're using is not a web browser, " +
                  "so the site won't work right. Please...\n\n" +
                  "Tap the ⋮ menu, then:\n\n" +
                  "“Open in external browser”"
                : "Sorry, the app you're using is not a web browser, " +
                  "so the site won't work right. Please...\n\n" +
                  "Tap the ⋯ menu, then:\n\n" +
                  "“Open in system browser”";
            msg.setAttribute('tabindex', '-1');
            modal.appendChild(msg);
            modal.appendChild(fallbackNote);
            document.body.appendChild(overlay);
            document.body.style.overflow = 'hidden';
            msg.focus();

            // Field data (PostHog replay, session 019f5407-a157-...,
            // 2026-07-12): Meta users tap the dimmed backdrop expecting the
            // page they can see around the modal to dismiss it (that's the
            // whole point of showing it) — 6 dead clicks on
            // #iab-escape-overlay itself, then the user gave up. Only the ×
            // had a handler. Dismiss on a direct tap on the backdrop too;
            // e.target === overlay excludes bubbled taps from the modal card.
            overlay.addEventListener('click', function (e) {
                if (e.target !== overlay) return;
                dismissOverlay('backdrop');
            });
            return;
        }

        msg.textContent = "Sorry, the app you're using is not a web browser, " +
            "so the site won't work correctly. Hit the button to open the " +
            "site in your preferred web browser";

        var btn = document.createElement('button');
        btn.type = 'button';
        btn.textContent = 'Open GPRA';
        btn.style.cssText = 'height:48px;padding:8px 40px;border:0;border-radius:6px;' +
            'background:#ea580c;color:#fff;font-size:17px;font-weight:600;cursor:pointer;';
        btn.addEventListener('click', function () {
            escapeWithCapture('button');
        });

        modal.appendChild(msg);
        modal.appendChild(btn);
        modal.appendChild(fallbackNote);
        document.body.appendChild(overlay);
        document.body.style.overflow = 'hidden';
        btn.focus();

        // Android's intent:// needs a user gesture (the gestureless auto
        // attempt below is silently blocked), so the FIRST tap anywhere on
        // the overlay (backdrop or modal) escapes — users don't have to hit
        // the button exactly. Once per session: if the WebView blocks the
        // intent, its fallback URL reloads this page, and re-arming the
        // one-shot would make every backdrop tap re-escape and re-reload —
        // backdrop-dismiss below would be unreachable. After one failed
        // gesture escape, taps degrade to dismissal (button still escapes).
        var escapeTapAt = 0;
        var gestureEscapeUsed = false;
        try { gestureEscapeUsed = !!sessionStorage.getItem('iabGestureEscapeAttempted'); } catch (e) {}
        if (isAndroid && !gestureEscapeUsed) {
            overlay.addEventListener('pointerdown', function onFirstTap(e) {
                // Button, dismiss, and copy-control taps have their own
                // behavior — return BEFORE consuming the one-shot, so those
                // taps don't burn the background-tap escape.
                if (btn.contains(e.target) || closeBtn.contains(e.target) ||
                    fallbackCopy.contains(e.target)) {
                    return;
                }
                overlay.removeEventListener('pointerdown', onFirstTap);
                try { sessionStorage.setItem('iabGestureEscapeAttempted', '1'); } catch (e) {}
                escapeTapAt = Date.now();
                escapeWithCapture('overlay_tap');
            });
        }

        // Backdrop taps dismiss here too (matching the Meta path) — but the
        // first Android tap is the escape gesture above, so its trailing
        // click event gets a pass before backdrop dismissal kicks in.
        overlay.addEventListener('click', function (e) {
            if (e.target !== overlay) return;
            if (Date.now() - escapeTapAt < 600) return;
            dismissOverlay('backdrop');
        });
    }

    // Block the page by default — the in-app copy shouldn't be usable — but
    // the modal is dismissable (×) as a last resort when the escape fails.
    // Skip it when the user already dismissed it this tab session (see
    // dismissOverlay) — reloads, including the cookie-consent reload, must
    // not bring it back.
    var overlayDismissed = false;
    try { overlayDismissed = !!sessionStorage.getItem('iabOverlayDismissed'); } catch (e) {}
    if (!overlayDismissed) {
        if (document.body) {
            showOverlay();
        } else {
            document.addEventListener('DOMContentLoaded', showOverlay);
        }
    }

    // Auto-escape once per session. Meta blocks it on both platforms and
    // Chromium blocks it gestureless everywhere, but it's harmless and free
    // where it still works (older app versions, permissive WebViews). If
    // sessionStorage is unavailable we skip the automatic attempt (no loop
    // protection) and rely on the gesture/button path.
    try {
        if (!sessionStorage.getItem('iabEscapeAttempted')) {
            sessionStorage.setItem('iabEscapeAttempted', '1');
            captureEvent('iab_escape_attempted', { iab_kind: iabKind });
            setTimeout(escapeToBrowser, 50);
        }
    } catch (e) { /* storage blocked — gesture/button-only escape */ }
})();
</script>
