<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="canonical" href="https://guitarpracticeroutine.com{{ request.path }}">
    <title>Guitar Practice Routine App</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="icon" type="image/png" sizes="48x48" href="/static/images/favicon-48x48.png">
    <link rel="apple-touch-icon" sizes="192x192" href="/static/images/GPRA-192x192.png">

    <!-- PWA -->
    <link rel="manifest" href="/static/manifest.json">
    <meta name="theme-color" content="#f97316">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <link rel="apple-touch-icon" href="/static/images/GPRA-192x192.png">

    <!-- Primary Meta Tags -->
    <meta name="description" content="GPRA helps guitarists organize practice routines, track progress, use focus timers, and create chord charts. For beginner and intermediate players.">

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://guitarpracticeroutine.com/">
    <meta property="og:title" content="Guitar Practice Routine App">
    <meta property="og:description" content="GPRA helps guitarists organize practice routines, track progress, use focus timers, and create chord charts. For beginner and intermediate players.">
    <meta property="og:image" content="https://guitarpracticeroutine.com/static/images/og-strat.png">

    <!-- Driver.js CSS (from CDN) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/driver.js@1.3.1/dist/driver.css">
    <!-- Custom Driver.js theme -->
    <link rel="stylesheet" href="{{ url_for('static', filename='css/driver-theme.css') }}?v={{ asset_version }}">
    <!-- Tailwind CSS -->
    <link rel="stylesheet" href="{{ url_for('static', filename='dist/css/main.css') }}?v={{ asset_version }}">
    {% block extra_css %}{% endblock %}

    <!-- Debug mode flag for frontend -->
    <script>
        window.GPRA_DEBUG = {{ 'true' if debug else 'false' }};
    </script>

    <!-- PostHog Analytics (shared partial; React captures pageviews manually) -->
    {% set posthog_capture_pageview = false %}
    {% include '_posthog_init.html.jinja' %}

</head>
<body class="bg-gray-900 text-gray-100 show-ph-widget">
    {% block content %}{% endblock %}
    {% block scripts %}{% endblock %}

    <!-- Theme Toggle (very small, de-emphasized) -->
    <div class="theme-toggle" onclick="toggleTheme()" title="Toggle light/dark mode" data-ph-capture-attribute-button="theme-toggle">
        <img id="light-mode-toggle"
             src="{{ url_for('static', filename='images/lightmodetoggle.png') }}"
             alt="Switch to Light Mode"
             style="height: 20px; width: 40px; display: block;">
        <img id="dark-mode-toggle"
             src="{{ url_for('static', filename='images/darkmodetoggle.png') }}"
             alt="Switch to Dark Mode"
             style="height: 20px; width: 40px; display: none;">
    </div>

    <!-- Theme Toggle JavaScript -->
    <script src="{{ url_for('static', filename='js/theme-toggle.js') }}?v={{ asset_version }}"></script>

    <!-- Service Worker Registration -->
    <script>
        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.register('/static/sw.js');
        }
    </script>
</body>
</html> 