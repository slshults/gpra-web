<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="canonical" href="https://guitarpracticeroutine.com{{ request.path }}">
    <title>Guitar Practice Routine App</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="icon" type="image/png" sizes="48x48" href="/static/images/favicon-48x48.png">
    <link rel="apple-touch-icon" sizes="192x192" href="/static/images/GPRA-192x192.png">

    <!-- PWA -->
    <link rel="manifest" href="/static/manifest.json">
    <meta name="theme-color" content="#f97316">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <link rel="apple-touch-icon" href="/static/images/GPRA-192x192.png">

    <!-- Primary Meta Tags -->
    <meta name="description" content="GPRA helps guitarists organize practice routines, track progress, use focus timers, and create chord charts. For beginner and intermediate players.">

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://guitarpracticeroutine.com/">
    <meta property="og:title" content="Guitar Practice Routine App">
    <meta property="og:description" content="GPRA helps guitarists organize practice routines, track progress, use focus timers, and create chord charts. For beginner and intermediate players.">
    <meta property="og:image" content="https://guitarpracticeroutine.com/static/images/og-strat.png">

    <!-- Driver.js CSS (from CDN) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/driver.js@1.3.1/dist/driver.css">
    <!-- Custom Driver.js theme -->
    <link rel="stylesheet" href="{{ url_for('static', filename='css/driver-theme.css') }}">
    <!-- Tailwind CSS -->
    <link rel="stylesheet" href="{{ url_for('static', filename='dist/css/main.css') }}?v={{ asset_version }}">
    {% block extra_css %}{% endblock %}

    <!-- Debug mode flag for frontend -->
    <script>
        window.GPRA_DEBUG = {{ 'true' if debug else 'false' }};
    </script>

    <!-- PostHog Analytics -->
    {% if posthog_key %}
    <script>
        // GDPR-Compliant PostHog Loading
        // Only load SDK if user explicitly accepts. Create stub otherwise.
        (function() {
            var cookieConsent = localStorage.getItem('cookieConsent');

            if (cookieConsent === 'all') {
                // User accepted all cookies - load PostHog SDK
                !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.crossOrigin="anonymous",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="init Ce js Ls Te Fs Ds capture Ye calculateEventProperties Us register register_once register_for_session unregister unregister_for_session Ws getFeatureFlag getFeatureFlagPayload isFeatureEnabled reloadFeatureFlags updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures on onFeatureFlags onSurveysLoaded onSessionId getSurveys getActiveMatchingSurveys renderSurvey canRenderSurvey canRenderSurveyAsync identify setPersonProperties group resetGroups setPersonPropertiesForFlags resetPersonPropertiesForFlags setGroupPropertiesForFlags resetGroupPropertiesForFlags reset get_distinct_id getGroups get_session_id get_session_replay_url alias set_config startSessionRecording stopSessionRecording sessionRecordingStarted captureException loadToolbar get_property getSessionProperty Bs zs createPersonProfile Hs Ms Gs opt_in_capturing opt_out_capturing has_opted_in_capturing has_opted_out_capturing get_explicit_consent_status is_capturing clear_opt_in_out_capturing Ns debug L qs getPageViewId captureTraceFeedback captureTraceMetric".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
                posthog.init('{{ posthog_key }}', {
                    disable_session_recording: window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1',
                    api_host: 'https://tacet.guitarpracticeroutine.com',
                    defaults: '2025-05-24',
                    person_profiles: 'identified_only',
                    capture_pageview: false,
                    capture_pageleave: true,
                    capture_exceptions: true,
                    opt_out_capturing_by_default: false,
                    session_recording: {
                        maskAllInputs: true
                    },
                    before_send: function(event) {
                        // Drop the benign "ResizeObserver loop completed with undelivered
                        // notifications" browser warning. It's emitted internally by Radix UI
                        // primitives (dialogs, selects, tooltips), is harmless, and only adds
                        // noise to the error-tracking inbox. See commit 3bca40f.
                        if (event && event.event === '$exception') {
                            var exceptionList = (event.properties &&
                                event.properties.$exception_list) || [];
                            for (var i = 0; i < exceptionList.length; i++) {
                                var value = exceptionList[i] && exceptionList[i].value;
                                if (typeof value === 'string' &&
                                    value.indexOf('ResizeObserver loop') !== -1) {
                                    return null;
                                }
                            }
                        }
                        return event;
                    }
                });
            } else {
                // User rejected or hasn't consented - create stub, don't load SDK
                window.posthog = {
                    capture: function() {},
                    identify: function() {},
                    opt_in_capturing: function() {
                        console.log('[PostHog] User opted in via toggle - reload page to enable tracking');
                    },
                    opt_out_capturing: function() {},
                    has_opted_out_capturing: function() { return true; },
                    has_opted_in_capturing: function() { return false; },
                    // Survey stubs - displaySurvey won't work without SDK, fallback handles this
                    displaySurvey: null,
                    getSurveys: function(callback) { callback([]); },
                    onSurveysLoaded: function(callback) { callback(); },
                    reset: function() {}
                };
            }
        })();
    </script>
    {% endif %}

</head>
<body class="bg-gray-900 text-gray-100 show-ph-widget">
    {% block content %}{% endblock %}
    {% block scripts %}{% endblock %}

    <!-- Theme Toggle (very small, de-emphasized) -->
    <div class="theme-toggle" onclick="toggleTheme()" title="Toggle light/dark mode" data-ph-capture-attribute-button="theme-toggle">
        <img id="light-mode-toggle"
             src="{{ url_for('static', filename='images/lightmodetoggle.png') }}"
             alt="Switch to Light Mode"
             style="height: 20px; width: 40px; display: block;">
        <img id="dark-mode-toggle"
             src="{{ url_for('static', filename='images/darkmodetoggle.png') }}"
             alt="Switch to Dark Mode"
             style="height: 20px; width: 40px; display: none;">
    </div>

    <!-- Theme Toggle JavaScript -->
    <script src="{{ url_for('static', filename='js/theme-toggle.js') }}"></script>

    <!-- Service Worker Registration -->
    <script>
        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.register('/static/sw.js');
        }
    </script>
</body>
</html> 