<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Find a guitar chord chart | Guitar Practice Routine</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%2210 0 100 100%22><text y=%22.90em%22 font-size=%2290%22>🎸</text></svg>">

    <!-- Primary Meta Tags -->
    <meta name="description" content="Look up guitar chord charts by name. Free, simple chord chart lookup — no account needed.">
    <link rel="canonical" href="https://guitarpracticeroutine.com/find-a-chord-chart">

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://guitarpracticeroutine.com/find-a-chord-chart">
    <meta property="og:title" content="Find a guitar chord chart | Guitar Practice Routine">
    <meta property="og:description" content="Look up guitar chord charts by name. Free, simple chord chart lookup — no account needed.">
    <meta property="og:image" content="https://guitarpracticeroutine.com/static/images/og-strat.png">

    <link rel="stylesheet" href="{{ url_for('static', filename='dist/css/main.css') }}">
    <link rel="stylesheet" href="{{ url_for('static', filename='css/CookieConsent.css') }}">

    <script>
        // Apply theme immediately to prevent flash (light-mode system)
        (function() {
            if (localStorage.getItem('lightMode') === 'true') {
                document.documentElement.classList.add('light-mode');
                document.documentElement.classList.remove('dark');
            }
        })();
    </script>
    <!-- PostHog Analytics -->
    {% if posthog_key %}
    <script>
        // GDPR-Compliant PostHog Loading
        (function() {
            var cookieConsent = localStorage.getItem('cookieConsent');
            if (cookieConsent === 'all') {
                !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.crossOrigin="anonymous",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="init capture identify".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
                posthog.init('{{ posthog_key }}', {
                    api_host: 'https://tacet.guitarpracticeroutine.com',
                    person_profiles: 'identified_only',
                    capture_pageview: true
                });
            } else {
                window.posthog = {
                    capture: function() {},
                    identify: function() {},
                    displaySurvey: null,
                    getSurveys: function(cb) { cb([]); },
                    onSurveysLoaded: function(cb) { cb(); }
                };
            }
        })();
    </script>
    {% endif %}

    <!-- Google AdSense Auto Ads - loads for CMP and AdSense crawlers -->
    {% if adsense_publisher_id %}
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client={{ adsense_publisher_id }}"
         crossorigin="anonymous"></script>
    {% endif %}

    <!-- Google Analytics 4 (consent-gated) -->
    <script>
        (function() {
            var cookieConsent = localStorage.getItem('cookieConsent');
            if (cookieConsent === 'all') {
                var s = document.createElement('script');
                s.async = true;
                s.src = 'https://www.googletagmanager.com/gtag/js?id=G-E3FNWSVY1J';
                document.head.appendChild(s);
                window.dataLayer = window.dataLayer || [];
                function gtag(){dataLayer.push(arguments);}
                gtag('js', new Date());
                gtag('config', 'G-E3FNWSVY1J');
            }
        })();
    </script>

    <style>
        /* Dark mode: ensure inputs have white text */
        #chord-editor-root input,
        #chord-editor-root select {
            color: #ffffff;
        }
        /* Light mode: inputs get dark text */
        html.light-mode #chord-editor-root input,
        html.light-mode #chord-editor-root select {
            color: #1f2937;
        }
        /* Light mode overrides for React chord editor */
        html.light-mode #chord-editor-root svg {
            filter: invert(1) hue-rotate(180deg);
        }
        html.light-mode #chord-editor-root .bg-gray-800 {
            background-color: #f3f4f6;
        }
        html.light-mode #chord-editor-root .text-white,
        html.light-mode #chord-editor-root .text-gray-200,
        html.light-mode #chord-editor-root .text-gray-300 {
            color: #1f2937;
        }
        html.light-mode #chord-editor-root .bg-gray-900 {
            background-color: #ffffff;
        }
        html.light-mode #chord-editor-root .bg-gray-700 {
            background-color: #e5e7eb;
        }
        html.light-mode #chord-editor-root .border-gray-700,
        html.light-mode #chord-editor-root .border-gray-600 {
            border-color: #d1d5db;
        }
        html.light-mode #chord-editor-root .text-blue-400 {
            color: #2563eb;
        }
    </style>
</head>
<body class="bg-gray-900 show-ph-widget">
    {% set current_page = 'find-a-chord-chart' %}
    {% include '_standalone_header.html.jinja' %}

    <div class="max-w-4xl mx-auto px-4 py-8">

        <!-- Page Header -->
        <div class="mb-8">
            <h1 class="text-4xl font-bold text-gray-900 dark:text-white mb-2">Find or make a guitar chord chart</h1>
            <p class="text-gray-600 dark:text-gray-400">Look up a chord by name to see how it's played.<br> 
            Edit the chord chart for different voicings, or just make your own from scratch.</p>
        </div>

        <div id="chord-editor-root" class="mb-6"></div>

        <!-- SVGuitar credit -->
        <div class="text-center text-xs text-gray-500 dark:text-gray-500 py-2 mb-2">
            Chord charts rendered with <a href="https://github.com/omnibrain/svguitar" target="_blank" rel="noopener noreferrer" class="hover:underline">SVGuitar</a>
        </div>

        <!-- CTA Section -->
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 mb-6">
            <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">Get charts for the whole song</h2>
            <div class="space-y-3 text-sm text-gray-700 dark:text-gray-300 leading-relaxed">
                <p>
                    <a href="https://guitarpracticeroutine.com/signup" class="text-orange-600 dark:text-orange-400 hover:underline">Sign up for GPRA</a> to create and save chord charts for an entire song.
                    Free for one routine with 15 practice items, no CC needed.<br>
                    For autocreated chord charts, bring your own
                    <a href="/faq#anthropic-api-key" class="text-orange-600 dark:text-orange-400 hover:underline">Anthropic API key</a>,
                    or upgrade to a paid account.
                    (<a href="/pricing" class="text-orange-600 dark:text-orange-400 hover:underline">See pricing here</a>.)

                </p>
                
            </div>
        </div>

        <!-- Footer Links -->
        <div class="text-center text-sm text-gray-600 dark:text-gray-400 py-4 border-t border-gray-200 dark:border-gray-700">
            <a href="/" class="hover:underline">Back to GPRA</a>
            ·
            <a href="/find-a-chord-chart" class="hover:underline">Find a chord chart</a>
            ·
            <a href="/about" class="hover:underline">About</a>
            ·
            <a href="/faq" class="hover:underline">Help</a>
            ·
            <a href="/pricing" class="hover:underline">Pricing</a>
            ·
            <a href="/terms" class="hover:underline">Terms</a>
            ·
            <a href="/privacy" class="hover:underline">Privacy</a>
            {% if not current_user.is_authenticated %}
            ·
            <a href="/login" class="hover:underline">Login</a>
            ·
            <a href="/signup" class="hover:underline">Sign up</a>
            {% endif %}
        </div>
    </div>

    <!-- Theme Toggle -->
    <div class="theme-toggle" onclick="toggleTheme()" title="Toggle light/dark mode">
        <img id="light-mode-toggle"
             src="{{ url_for('static', filename='images/lightmodetoggle.png') }}"
             alt="Switch to Light Mode"
             style="height: 20px; width: 40px; display: block;">
        <img id="dark-mode-toggle"
             src="{{ url_for('static', filename='images/darkmodetoggle.png') }}"
             alt="Switch to Dark Mode"
             style="height: 20px; width: 40px; display: none;">
    </div>

    <script src="{{ url_for('static', filename='js/theme-toggle.js') }}"></script>
    <script type="module" src="{{ url_for('static', filename='dist/js/chord-editor.js') }}?v={{ asset_version }}"></script>

    {% include '_cookie_consent_banner.html.jinja' %}
</body>
</html>
