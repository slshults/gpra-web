    <style>
        /* Chart container sizing — matches the app's chord chart dimensions */
        #chord-chart-container {
            width: 128px;
            height: 176px;
            flex-shrink: 0;
        }

        /* Light mode: invert chart colors to dark-on-light */
        html.light-mode #chord-chart-container svg {
            filter: invert(1) hue-rotate(180deg);
        }

        /* Input focus ring in GPRA orange */
        #chord-name-input:focus {
            outline: none;
            border-color: #ea580c;
            box-shadow: 0 0 0 2px rgba(234, 88, 12, 0.3);
        }
    </style>
</head>
<body class="bg-gray-900 show-ph-widget">
    {% set current_page = 'find-a-chord-chart' %}
    {% include '_standalone_header.html.jinja' %}

    <div class="max-w-4xl mx-auto px-4 py-8">

        <!-- Page Header -->
        <div class="mb-8">
            <h1 class="text-4xl font-bold text-gray-900 dark:text-white mb-2">Find a guitar chord chart</h1>
            <p class="text-gray-600 dark:text-gray-400">Look up a chord by name to see how it's played. No account needed.</p>
        </div>

        <!-- Chord Lookup Widget -->
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 mb-6">

            <!-- Input -->
            <div class="mb-6">
                <label for="chord-name-input" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                    Chord name
                </label>
                <input
                    id="chord-name-input"
                    type="text"
                    placeholder="e.g. Am, G, F#m7, Cmaj7"
                    autocomplete="off"
                    autocorrect="off"
                    autocapitalize="off"
                    spellcheck="false"
                    class="w-full max-w-xs px-3 py-2 rounded-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 text-sm transition-colors"
                >
            </div>

            <!-- Result area -->
            <div id="chord-result" class="min-h-[180px] flex items-start gap-6">
                <!-- Empty state -->
                <div id="state-empty" class="text-gray-500 dark:text-gray-400 text-sm py-2">
                    Enter a chord name above to see the chart.
                </div>

                <!-- Loading state (hidden by default) -->
                <div id="state-loading" class="hidden text-gray-500 dark:text-gray-400 text-sm py-2">
                    Looking up chord&hellip;
                </div>

                <!-- Not found state (hidden by default) -->
                <div id="state-not-found" class="hidden text-gray-500 dark:text-gray-400 text-sm py-2">
                    Chord not found. Try a different name.
                </div>

                <!-- Chart state (hidden by default) -->
                <div id="state-chart" class="hidden flex-col gap-3">
                    <div class="flex items-start gap-4">
                        <!-- SVGuitar renders into this div -->
                        <div id="chord-chart-container"></div>
                        <div class="pt-1">
                            <p id="chord-chart-title" class="text-lg font-semibold text-gray-900 dark:text-white mb-1"></p>
                            <p id="chord-tuning-note" class="text-xs text-gray-500 dark:text-gray-400 hidden">
                                Most common voicing &middot; standard tuning
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- SVGuitar credit -->
        <div class="text-center text-xs text-gray-500 dark:text-gray-500 py-2 mb-2">
            Chord charts rendered with <a href="https://github.com/omnibrain/svguitar" target="_blank" rel="noopener noreferrer" class="hover:underline">SVGuitar</a>
        </div>

        <!-- CTA Section -->
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 mb-6">
            <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">Want to do more with chord charts?</h2>
            <div class="space-y-3 text-sm text-gray-700 dark:text-gray-300 leading-relaxed">
                <p>
                    Want to create and save chord charts for an entire song?
                    <a href="https://guitarpracticeroutine.com/signup" class="text-orange-600 dark:text-orange-400 hover:underline">Sign up for GPRA</a>.
                    No credit card needed for a free account with 15 practice items in one free routine.
                </p>
                <p>
                    For autocreated chord charts, bring your own
                    <a href="/faq#anthropic-api-key" class="text-orange-600 dark:text-orange-400 hover:underline">Anthropic API key</a>,
                    or upgrade to a paid account.
                    (<a href="/pricing" class="text-orange-600 dark:text-orange-400 hover:underline">See pricing here</a>.)
                </p>
            </div>
        </div>

        <!-- Footer Links -->
        <div class="text-center text-sm text-gray-600 dark:text-gray-400 py-4 border-t border-gray-200 dark:border-gray-700">
            <a href="/" class="hover:underline">Back to GPRA</a>
            ·
            <a href="/find-a-chord-chart" class="hover:underline">Find a chord chart</a>
            ·
            <a href="/about" class="hover:underline">About</a>
            ·
            <a href="/faq" class="hover:underline">Help</a>
            ·
            <a href="/pricing" class="hover:underline">Pricing</a>
            ·
            <a href="/terms" class="hover:underline">Terms</a>
            ·
            <a href="/privacy" class="hover:underline">Privacy</a>
            {% if not current_user.is_authenticated %}
            ·
            <a href="/login" class="hover:underline">Login</a>
            ·
            <a href="/signup" class="hover:underline">Sign up</a>
            {% endif %}
        </div>
    </div>

    <!-- Theme Toggle -->
    <div class="theme-toggle" onclick="toggleTheme()" title="Toggle light/dark mode">
        <img id="light-mode-toggle"
             src="{{ url_for('static', filename='images/lightmodetoggle.png') }}"
             alt="Switch to Light Mode"
             style="height: 20px; width: 40px; display: block;">
        <img id="dark-mode-toggle"
             src="{{ url_for('static', filename='images/darkmodetoggle.png') }}"
             alt="Switch to Dark Mode"
             style="height: 20px; width: 40px; display: none;">
    </div>

    <script src="{{ url_for('static', filename='js/theme-toggle.js') }}"></script>

    <!-- SVGuitar library (UMD build required for window.svguitar global) -->
    <script src="https://omnibrain.github.io/svguitar/js/svguitar.umd.js"></script>

    <script>
    (function() {
        var input = document.getElementById('chord-name-input');
        var container = document.getElementById('chord-chart-container');

        var stateEmpty    = document.getElementById('state-empty');
        var stateLoading  = document.getElementById('state-loading');
        var stateNotFound = document.getElementById('state-not-found');
        var stateChart    = document.getElementById('state-chart');
        var chartTitle    = document.getElementById('chord-chart-title');
        var tuningNote    = document.getElementById('chord-tuning-note');

        var currentRequest = 0; // used to discard stale responses

        var stateElements = {
            empty: stateEmpty,
            loading: stateLoading,
            notfound: stateNotFound,
            chart: stateChart
        };

        function showState(name) {
            Object.values(stateElements).forEach(function(el) { el.classList.add('hidden'); });
            stateElements[name].classList.remove('hidden');
        }

        function renderChart(chordData) {
            // Clear previous render
            container.innerHTML = '';

            var config = {
                strings: chordData.numStrings || 6,
                frets: chordData.numFrets || 5,
                position: chordData.startingFret || 1,
                fretSize: 1.2,
                fingerSize: 0.75,
                sidePadding: 0.2,
                fontFamily: 'Arial',
                width: 128,
                height: 176,
                color: '#ffffff',
                backgroundColor: 'transparent',
                strokeColor: '#ffffff',
                textColor: '#ffffff',
                fretLabelColor: '#ffffff',
                fingerTextColor: '#000000',
                fingerTextSize: 28,
                tuning: []
            };

            // Build the full fingers array, including open and muted strings
            var allFingers = (chordData.fingers || []).slice();
            (chordData.openStrings || []).forEach(function(s) {
                allFingers.push([s, 0]);
            });
            (chordData.mutedStrings || []).forEach(function(s) {
                allFingers.push([s, 'x']);
            });

            try {
                new window.svguitar.SVGuitarChord(container)
                    .configure(config)
                    .chord({
                        fingers: allFingers,
                        barres: chordData.barres || []
                    })
                    .draw();
            } catch (e) {
                console.error('SVGuitar render error:', e);
            }
        }

        function lookup(chordName) {
            chordName = chordName.trim();
            if (!chordName) {
                showState('empty');
                return;
            }

            var reqId = ++currentRequest;
            showState('loading');

            fetch('/api/chord-charts/common/search?name=' + encodeURIComponent(chordName))
                .then(function(res) { return res.json(); })
                .then(function(data) {
                    if (reqId !== currentRequest) return; // stale response, ignore
                    if (!Array.isArray(data) || data.length === 0) {
                        showState('notfound');
                        return;
                    }
                    var chord = data[0];
                    chartTitle.textContent = chord.title || chordName;
                    tuningNote.classList.remove('hidden');
                    renderChart(chord);
                    showState('chart');
                })
                .catch(function() {
                    if (reqId !== currentRequest) return;
                    showState('notfound');
                });
        }

        // Trigger on Enter key
        input.addEventListener('keydown', function(e) {
            if (e.key === 'Enter') {
                lookup(input.value);
            }
        });

        // Trigger on blur (clicking away)
        input.addEventListener('blur', function() {
            if (input.value.trim()) {
                lookup(input.value);
            }
        });

        // Clear when input is emptied
        input.addEventListener('input', function() {
            if (!input.value.trim()) {
                currentRequest++; // cancel any in-flight lookup
                showState('empty');
            }
        });
    })();
    </script>

    {% include '_cookie_consent_banner.html.jinja' %}
</body>
</html>
