                    <div class="frame"><div class="frame__body">
                        <video autoplay muted loop playsinline preload="metadata">
                            <source src="{{ url_for('static', filename='images/tour/AddItemsToRoutine.mp4') }}" type="video/mp4">
                        </video>
                    </div></div>
                </div>
            </div>
        </section>

        <!-- Drag-n-drop reordering (media right) -->
        <section class="feature feature--plain">
            <div class="feature__row">
                <div class="feature__copy" data-reveal>
                    <div class="eyebrow">Routines</div>
                    <h2>Drag-n-drop reordering</h2>
                    <p>Rearrange items within a routine just by dragging. Put first things first and find the order that fits your flow.</p>
                    <a class="cta-arrow" href="/signup" data-cta="drag_reorder">Try it free <span>&rarr;</span></a>
                </div>
                <div class="feature__media" data-reveal data-reveal-delay="90">
                    <div class="frame"><div class="frame__body">
                        <img src="{{ url_for('static', filename='images/dragndrop.png') }}" alt="Drag-and-drop reordering" loading="lazy">
                    </div></div>
                </div>
            </div>
        </section>

        <!-- Practice with focus (media left) -->
        <section class="feature feature--tinted">
            <div class="feature__row reverse">
                <div class="feature__copy" data-reveal>
                    <div class="eyebrow">Focus</div>
                    <h2>Practice with focus</h2>
                    <p>Built-in timers, with adjustable volume notification sound, and item completion tracking keep every session deliberate. No gamification, no confetti, no ads, just focused practice.</p>
                    <a class="cta-arrow" href="/signup" data-cta="practice_timer">Start free <span>&rarr;</span></a>
                </div>
                <div class="feature__media" data-reveal data-reveal-delay="90">
                    <div class="frame"><div class="frame__body">
                        <video autoplay muted loop playsinline preload="metadata">
                            <source src="{{ url_for('static', filename='images/Timer.mp4') }}" type="video/mp4">
                        </video>
                    </div></div>
                </div>
            </div>
        </section>

        <!-- Track your progress (media right) -->
        <section class="feature feature--plain">
            <div class="feature__row">
                <div class="feature__copy" data-reveal>
                    <div class="eyebrow">Progress</div>
                    <h2>Track your progress</h2>
                    <p>See your consistency over time with simple practice stats showing what you practiced, and for how long. No badges, no leveling-up, no trophies, because you're not a child who needs a dopamine cookie, you're a guitarist who needs practice.</p>
                    <a class="cta-arrow" href="/signup" data-cta="stats">See your stats <span>&rarr;</span></a>
                </div>
                <div class="feature__media" data-reveal data-reveal-delay="90">
                    <div class="frame"><div class="frame__body">
                        <img class="contain" src="{{ url_for('static', filename='images/Stats.jpg') }}" alt="Practice stats" loading="lazy">
                    </div></div>
                </div>
            </div>
        </section>

        <!-- Your data, yours to keep (media left) -->
        <section class="feature feature--tinted">
            <div class="feature__row reverse">
                <div class="feature__copy" data-reveal>
                    <div class="eyebrow">Ownership</div>
                    <h2>Your data, yours to keep</h2>
                    <p>Download all your items, routines, chord charts, and practice history anytime, for free. Because it's your stuff, you built it. GPRA just gave you the tools to build it with. And if you're on a paid plan, but you need to take a break from paying for a while, I'll hold onto your stuff for you for 90 days, so it'll be waiting for you when you're back.</p>
                    <a class="cta-arrow" href="/signup" data-cta="data_ownership">Start free <span>&rarr;</span></a>
                </div>
                <div class="feature__media" data-reveal data-reveal-delay="90">
                    <div class="frame"><div class="frame__body">
                        <img class="contain" src="{{ url_for('static', filename='images/download.png') }}" alt="Download your data" loading="lazy">
                    </div></div>
                </div>
            </div>
        </section>

        <!-- Final CTA -->
        <section class="feature feature--plain" style="padding:clamp(64px,10vh,128px) 0">
            <div style="max-width:720px; margin:0 auto; padding:0 24px; text-align:center">
                <h2 data-reveal style="font-size:clamp(30px,4.4vw,50px); font-weight:700; line-height:1.08; letter-spacing:-.02em; color:var(--heading); margin:0 0 18px">Start your free practice routine today</h2>
                <p data-reveal data-reveal-delay="70" style="font-size:clamp(16px,1.4vw,19px); line-height:1.6; color:var(--muted); margin:0 auto 30px; max-width:48ch">Create your practice items, then set up your first routine in minutes. No credit card, no spam, no ads, just the tools to get your practice on.</p>
                <div data-reveal data-reveal-delay="130" style="display:flex; flex-direction:column; align-items:center; gap:12px">
                    <a class="btn-cta" href="/signup" data-cta="final">Start free</a>
                    <span style="font-size:13px; color:var(--muted)">no credit card needed</span>
