        .video-info-tooltip { position:absolute; top:12px; left:50%; transform:translateX(-50%); z-index:2; max-width:88%; padding:10px 14px; border-radius:8px; background:rgba(17,24,39,.92); color:#fff; font-size:13px; line-height:1.45; font-weight:500; text-align:center; box-shadow:0 8px 24px -8px rgba(0,0,0,.6); pointer-events:none; opacity:0; transition:opacity .25s ease; }
