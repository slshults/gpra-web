    </div>

    <!-- Footer links -->
    <div class="text-center text-sm text-gray-400 py-2 mt-1">
        <a href="/find-a-chord-chart" class="hover:underline hover:text-gray-400">Find a chord chart</a>
        <span> &middot; </span>
        <a href="/about" class="hover:underline hover:text-gray-400">About</a>
        <span> &middot; </span>
        <a href="/why" class="hover:underline hover:text-gray-400">Why</a>
        <span> &middot; </span>
        <a href="/faq" class="hover:underline hover:text-gray-400">Help</a>
        <span> &middot; </span>
        <a href="/pricing" class="hover:underline hover:text-gray-400">Pricing</a>
        <span> &middot; </span>
        <a href="/terms" class="hover:underline hover:text-gray-400">Terms</a>
        <span> &middot; </span>
        <a href="/privacy" class="hover:underline hover:text-gray-400">Privacy</a>
    </div>

    <!-- Theme Toggle -->
    <div class="theme-toggle" onclick="toggleTheme()" title="Toggle light/dark mode">
        <img id="light-mode-toggle"
             src="{{ url_for('static', filename='images/lightmodetoggle.png') }}"
             alt="Switch to Light Mode"
             style="height: 20px; width: 40px; display: block;">
        <img id="dark-mode-toggle"
             src="{{ url_for('static', filename='images/darkmodetoggle.png') }}"
             alt="Switch to Dark Mode"
             style="height: 20px; width: 40px; display: none;">
    </div>

    <script src="{{ url_for('static', filename='js/theme-toggle.js') }}"></script>

    <!-- Scroll reveal for feature sections -->
    <script>
        (function () {
            var els = Array.prototype.slice.call(document.querySelectorAll('[data-reveal]'));
            function reveal(el) {
                if (el.__revealed) return;
                el.__revealed = true;
                var d = parseInt(el.getAttribute('data-reveal-delay') || '0', 10);
                setTimeout(function () { el.classList.add('is-visible'); }, d);
            }
            if ('IntersectionObserver' in window) {
                var io = new IntersectionObserver(function (entries) {
                    entries.forEach(function (e) { if (e.isIntersecting) { reveal(e.target); io.unobserve(e.target); } });
                }, { threshold: 0.08, rootMargin: '0px 0px -6% 0px' });
                els.forEach(function (el) { io.observe(el); });
            } else {
                els.forEach(reveal);
            }
        })();
    </script>

    <!-- CTA click tracking (delegated). Fires landing_cta_clicked for any [data-cta].
         Guarded on window.posthog so it no-ops when consent isn't 'all' (PostHog not loaded).
         No preventDefault/delay needed: posthog.capture is non-blocking and PostHog flushes
         pending events via sendBeacon on pagehide/unload, so the event survives navigation. -->
    <script>
        document.addEventListener('click', function (e) {
            var el = e.target.closest('[data-cta]');
            if (!el || !window.posthog) return;
            window.posthog.capture('landing_cta_clicked', {
                cta_location: el.getAttribute('data-cta'),
                cta_label: (el.textContent || '').trim(),
                cta_destination: el.getAttribute('href')
            });
        });
    </script>

    <!-- Service Worker Registration -->
    <script>
        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.register('/static/sw.js');
        }
    </script>

    {% include '_cookie_consent_banner.html.jinja' %}

    <!-- PostHog Analytics -->
    {% if posthog_key %}
    <script>
        // GDPR-Compliant PostHog Loading
        (function() {
            var cookieConsent = localStorage.getItem('cookieConsent');
            if (cookieConsent === 'all') {
                !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.crossOrigin="anonymous",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="init capture identify".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
                posthog.init('{{ posthog_key }}', {
                    disable_session_recording: window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1',
                    api_host: 'https://tacet.guitarpracticeroutine.com',
                    person_profiles: 'identified_only',
                    capture_pageview: true,
                    capture_exceptions: true,
                    session_recording: {
                        maskAllInputs: true
