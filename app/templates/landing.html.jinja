    <!-- Scroll reveal for feature sections -->
    <script>
        (function () {
            var els = Array.prototype.slice.call(document.querySelectorAll('[data-reveal]'));
            function reveal(el) {
                if (el.__revealed) return;
                el.__revealed = true;
                var d = parseInt(el.getAttribute('data-reveal-delay') || '0', 10);
                setTimeout(function () { el.classList.add('is-visible'); }, d);
            }
            if ('IntersectionObserver' in window) {
                var io = new IntersectionObserver(function (entries) {
                    entries.forEach(function (e) { if (e.isIntersecting) { reveal(e.target); io.unobserve(e.target); } });
                }, { threshold: 0.08, rootMargin: '0px 0px -6% 0px' });
                els.forEach(function (el) { io.observe(el); });
            } else {
                els.forEach(reveal);
            }
        })();
    </script>

    <!-- Feature video playback + lazy loading. The tour <video> tags ship with
         preload="none" and no autoplay (so ~5MB of video doesn't compete for bandwidth
         during initial paint / FCP). An IntersectionObserver loads + plays each video only
         as it nears the viewport, and pauses it again when it scrolls out (saves CPU/battery).
         Two mobile-browser problems are also handled here:
         1) Looping: the <video> tags carry the native `loop` attribute, but some mobile
            browsers (e.g. Cromite/Chromium on Android) drop the loop after one play. We
            re-loop on `ended`.
         2) Blocked autoplay: when autoplay is disabled in the browser's site settings, muted
            play() silently fails and the video sits frozen. We detect that (play() rejects)
            when the video scrolls into view and reveal a tap-to-play overlay. Users whose
            autoplay works never see the overlay — play() resolves and the video plays normally. -->
    <script>
        (function () {
            var vids = Array.prototype.slice.call(document.querySelectorAll('.feature__media video.lazy-video'));
            if (!vids.length) return;

            function hideOverlay(video) {
                var ov = video.parentNode && video.parentNode.querySelector('.video-tap-overlay');
                if (ov) ov.remove();
            }
            function tryPlay(video, onBlocked) {
                // Promote preload + kick off the network fetch the first time we want to play.
                if (video.preload !== 'auto') { video.preload = 'auto'; video.load(); }
                var p = video.play();
                if (p && p.then) {
                    p.then(function () { hideOverlay(video); }).catch(function () { if (onBlocked) onBlocked(video); });
                }
            }
            function showOverlay(video) {
                var body = video.parentNode;
                if (!body || body.querySelector('.video-tap-overlay')) return;
                var btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'video-tap-overlay';
                btn.setAttribute('aria-label', 'Play video');
                btn.innerHTML = '<span class="video-tap-overlay__icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg></span><span class="video-tap-overlay__label">Tap to play</span>';
                btn.addEventListener('click', function () {
                    // A user gesture is allowed to start playback even when autoplay is blocked.
                    tryPlay(video);
                    // Start any other still-paused videos off this same gesture, so one tap
                    // generally unblocks the whole page.
                    vids.forEach(function (other) { if (other !== video && other.paused) tryPlay(other); });
                });
                body.appendChild(btn);
            }

            // Show a "not interactive" callout when a user clicks a playing video. The tap-to-play
            // overlay (position:absolute; inset:0) covers the video while autoplay is blocked and
            // swallows the click, so a click that reaches the <video> means it's already playing —
            // i.e. the user thinks the video is interactive. One tooltip per media block; a repeat
            // click resets the 3s timer instead of stacking duplicates.
            function showInfoTooltip(video) {
                var body = video.parentNode;
                if (!body) return;
                var tip = body.querySelector('.video-info-tooltip');
                if (!tip) {
                    tip = document.createElement('div');
                    tip.className = 'video-info-tooltip';
                    tip.setAttribute('role', 'status');
                    tip.innerHTML = "This is a video. It's not interactive.<br>Create an account to try out GPRA.";
                    body.appendChild(tip);
                }
                if (tip._hideTimer) { clearTimeout(tip._hideTimer); }
                // Force reflow so re-adding is-visible re-triggers the fade-in transition.
                void tip.offsetWidth;
                tip.classList.add('is-visible');
                tip._hideTimer = setTimeout(function () {
                    tip.classList.remove('is-visible');
                }, 3000);
            }

            vids.forEach(function (v) {
                v.loop = true;
                // Keep looping even if a mobile browser drops the native loop after one play.
                v.addEventListener('ended', function () {
                    v.currentTime = 0;
                    var p = v.play();
                    if (p && p.catch) { p.catch(function () {}); }
                });
                v.addEventListener('click', function () { showInfoTooltip(v); });
            });

            // Load + play each video as it nears the viewport; pause it when it leaves.
            // rootMargin starts the fetch ~200px early so there's no blank frame on entry.
            if ('IntersectionObserver' in window) {
                var io = new IntersectionObserver(function (entries) {
                    entries.forEach(function (e) {
                        if (e.isIntersecting) {
                            tryPlay(e.target, showOverlay);
                        } else if (!e.target.paused) {
                            e.target.pause();
                        }
                    });
                }, { rootMargin: '200px 0px', threshold: 0 });
                vids.forEach(function (v) { io.observe(v); });
            } else {
                vids.forEach(function (v) { tryPlay(v, showOverlay); });
            }
        })();
    </script>

    <!-- CTA click tracking (delegated). Fires landing_cta_clicked for any [data-cta].
         Guarded on window.posthog so it no-ops when consent isn't 'all' (PostHog not loaded).
         No preventDefault/delay needed: posthog.capture is non-blocking and PostHog flushes
         pending events via sendBeacon on pagehide/unload, so the event survives navigation. -->
    <script>
        document.addEventListener('click', function (e) {
            var el = e.target.closest('[data-cta]');
            if (!el || !window.posthog) return;
            window.posthog.capture('landing_cta_clicked', {
                cta_location: el.getAttribute('data-cta'),
                cta_label: (el.textContent || '').trim(),
                cta_destination: el.getAttribute('href')
            });
        });
    </script>

    <!-- Service Worker Registration -->
    <script>
        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.register('/static/sw.js');
        }
    </script>

