        .frame__body { position:relative; background:var(--frame-body); font-size:0; display:flex; justify-content:center; }
        /* Tap-to-play overlay: injected by JS only when a feature video's autoplay is blocked
           (e.g. autoplay disabled in Chromite/Opera Mobile site settings). Users whose autoplay
           works never see this. */
        .video-tap-overlay { position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:10px; padding:0; margin:0; border:0; cursor:pointer; background:rgba(17,24,39,.5); color:#fff; -webkit-tap-highlight-color:transparent; }
        .video-tap-overlay__icon { width:62px; height:62px; border-radius:50%; background:var(--btn); display:flex; align-items:center; justify-content:center; box-shadow:0 8px 24px -8px rgba(0,0,0,.6); }
        .video-tap-overlay__icon svg { width:26px; height:26px; fill:#fff; margin-left:3px; }
        .video-tap-overlay__label { font-size:14px; font-weight:600; letter-spacing:.01em; }
        /* Floating callout shown when a user clicks a playing tour video expecting it to be
