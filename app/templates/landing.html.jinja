<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="canonical" href="https://guitarpracticeroutine.com{{ request.path }}">
    <title>Guitar Practice Routine App</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="icon" type="image/png" sizes="48x48" href="/static/images/favicon-48x48.png">
    <link rel="apple-touch-icon" sizes="192x192" href="/static/images/GPRA-192x192.png">

    <!-- PWA -->
    <link rel="manifest" href="/static/manifest.json">
    <meta name="theme-color" content="#f97316">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <link rel="apple-touch-icon" href="/static/images/GPRA-192x192.png">

    <!-- Primary Meta Tags -->
    <meta name="description" content="GPRA helps guitarists organize practice routines, track progress, use focus timers, and create chord charts. For beginner and intermediate players.">

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://guitarpracticeroutine.com/">
    <meta property="og:title" content="Guitar Practice Routine App">
    <meta property="og:description" content="GPRA helps guitarists organize practice routines, track progress, use focus timers, and create chord charts. For beginner and intermediate players.">
    <meta property="og:image" content="https://guitarpracticeroutine.com/static/images/og-strat.png">

    <link rel="stylesheet" href="{{ url_for('static', filename='dist/css/main.css') }}">
    <link rel="stylesheet" href="{{ url_for('static', filename='css/CookieConsent.css') }}">

    <!-- Hash validation: redirect invalid hashes to 404 before rendering landing page.
         Unauthenticated users visiting /#InvalidHash should see 404, not the landing page. -->
    <script>
        (function() {
            var hash = window.location.hash.slice(1).split('?')[0];
            var validPages = ['Practice', 'Routines', 'Items', 'Stats', 'Account'];
            if (hash && validPages.indexOf(hash) === -1) {
                window.location.replace('/invalid-route-404');
            }
        })();
    </script>

    <style>
        /* Light mode overrides */
        .light-mode {
            background-color: #f3f4f6 !important;
        }
        .light-mode .text-gray-300 {
            color: #374151 !important;
        }
        .light-mode .text-gray-400 {
            color: #4b5563 !important;
        }
        .light-mode .text-gray-500 {
            color: #6b7280 !important;
        }
        .light-mode .text-gray-600 {
            color: #4b5563 !important;
        }
        .light-mode .bg-gray-800 {
            background-color: #e5e7eb !important;
        }
        .light-mode .bg-gray-800:hover {
            background-color: #d1d5db !important;
        }
        .light-mode .text-gray-200 {
            color: #1f2937 !important;
        }
        .light-mode .border-gray-600 {
            border-color: #9ca3af !important;
        }
        .light-mode .border-gray-700 {
            border-color: #d1d5db !important;
        }
        .light-mode a.hover\:text-gray-400:hover {
            color: #1f2937 !important;
        }
        /* Card background in light mode */
        .light-mode .bg-gray-800.rounded-lg {
            background-color: #ffffff !important;
        }

        /* ===== Landing feature sections (scroll storytelling) ===== */
        :root {
            --bg:#111827; --card:#1f2937; --surface-2:#374151;
            --text:#d1d5db; --heading:#f9fafb; --muted:#9ca3af; --border:#374151;
            --accent:#f97316; --btn:#ea580c; --btn-hover:#c2410c;
            --frame-bg:#1f2937; --frame-body:#111827;
        }
        body.light-mode {
            --bg:#f3f4f6; --card:#ffffff; --surface-2:#e5e7eb;
            --text:#374151; --heading:#1f2937; --muted:#4b5563; --border:#d1d5db;
            --frame-bg:#ffffff; --frame-body:#e5e7eb;
        }
        .landing-features { width:100%; display:flex; flex-direction:column; align-items:stretch; margin-top:24px; }
        .feature { padding:clamp(56px,8vh,104px) 0; }
        .feature--tinted { background:var(--card); border-top:1px solid var(--border); }
        .feature--plain { background:var(--bg); border-top:1px solid var(--border); }
        .feature__row { max-width:1130px; margin:0 auto; padding:0 24px; display:flex; flex-wrap:wrap; align-items:center; gap:clamp(32px,6vw,80px); }
        .feature__row.reverse { flex-direction:row-reverse; }
        .feature__copy { flex:1 1 380px; min-width:280px; }
        .feature__media { flex:1 1 440px; min-width:280px; }
        .eyebrow { font-size:13px; font-weight:600; letter-spacing:.1em; text-transform:uppercase; color:var(--accent); margin-bottom:14px; }
        .feature h2 { font-size:clamp(28px,3.4vw,42px); font-weight:700; line-height:1.1; letter-spacing:-.02em; color:var(--heading); margin:0 0 16px; }
        .feature p { font-size:clamp(16px,1.3vw,18px); line-height:1.6; color:var(--muted); margin:0 0 24px; max-width:46ch; }
        .frame { border:1px solid var(--border); border-radius:10px; overflow:hidden; background:var(--frame-bg); box-shadow:0 14px 34px -18px rgba(0,0,0,.5); }
        .frame__body { background:var(--frame-body); font-size:0; display:flex; justify-content:center; }
        .frame__body > img, .frame__body > video { display:block; width:100%; height:auto; }
        .frame__body > img.contain { width:auto; max-width:100%; }
        .cta-arrow { display:inline-flex; align-items:center; gap:8px; font-weight:600; font-size:15px; color:var(--accent); text-decoration:none; transition:gap .15s; }
        .cta-arrow:hover { gap:13px; }
        .btn-cta { display:inline-flex; align-items:center; justify-content:center; border-radius:6px; text-decoration:none; height:44px; padding:8px 32px; background:var(--btn); color:#fff; font-size:16px; font-weight:600; transition:background .15s; }
        .btn-cta:hover { background:var(--btn-hover); }
        [data-reveal] { opacity:0; transform:translateY(22px); transition:opacity .7s cubic-bezier(.2,.7,.2,1), transform .7s cubic-bezier(.2,.7,.2,1); }
        [data-reveal].is-visible { opacity:1; transform:none; }
        @media (prefers-reduced-motion: reduce) {
            [data-reveal] { opacity:1; transform:none; transition:none; }
        }

        /* Intro card: full-ish on mobile (unchanged), widened to match feature content on desktop.
           On desktop the content is centered as a group (shared left edge, text stays left-aligned),
           and the buttons stay compact so they don't stretch across the wide card. */
        .landing-intro-card { max-width: 32rem; }
        /* Account note sits last in the card on every breakpoint (below the buttons on desktop;
           on mobile, after the intro text). Set in plain CSS so it doesn't depend on a Tailwind
           order-3 utility being compiled into main.css. */
        .landing-intro-note { order: 3; }
        @media (min-width: 640px) {
            .landing-intro-card { max-width: 1130px; }
            .landing-intro-content { width: fit-content; margin-left: auto; margin-right: auto; align-items: flex-start; }
            .landing-intro-note { margin-top: 8px; }
            .landing-intro-buttons a { width: 100px; white-space: nowrap; }
        }
    </style>
    <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Guitar Practice Routine App",
  "url": "https://guitarpracticeroutine.com",
  "logo": "https://guitarpracticeroutine.com/static/images/favico.png"
}
    </script>
</head>
<body class="bg-gray-900">
    <script>
        // Apply theme immediately to prevent flash
        (function() {
            if (localStorage.getItem('lightMode') === 'true') {
                document.documentElement.classList.add('light-mode');
                document.documentElement.classList.remove('dark');
            }
        })();
    </script>

    <div class="flex flex-col items-center px-4 py-3">
        <!-- App title -->
        <div class="text-center mb-2 mt-4">
            <h1 class="text-3xl font-bold text-orange-500 mb-2">
                🎸 Guitar Practice Routine App
            </h1>
        </div>

        <!-- Main content card -->
        <div class="w-full landing-intro-card">
            <div class="bg-gray-800 rounded-lg border border-gray-700 p-6 flex flex-col">
                <!-- Content column: full width on mobile; on desktop it is centered within
                     the wide card while each line of text keeps a shared left edge. -->
                <div class="flex flex-col landing-intro-content">
                    <!-- Intro paragraphs (left-aligned). On mobile, ordered below the action
                         buttons so visitors see Login/Sign up without needing to scroll. -->
                    <div class="order-2 sm:order-1">
                        <p class="text-gray-300 mb-2 text-left text-lg leading-relaxed">
                            A web app for beginner and intermediate guitar players.
                        </p>
                        <p class="text-gray-300 mb-2 text-left text-lg leading-relaxed">
                            No bloat, no gamification, no badges, no confetti, no ads, no spam.
                        </p>
                        <p class="text-gray-300 mb-2 text-left text-lg leading-relaxed">
                            Just the tools you need to organize and track your practice.
                        </p>
                    </div>

                    <!-- Action buttons (stacked, matching login button: h-9 py-2).
                         order-1 on mobile puts them above the intro text; sm:order-2 restores
                         the below-text placement on desktop. -->
                    <div class="flex flex-col gap-2 order-1 sm:order-2 mb-4 sm:mb-0 sm:mt-2 landing-intro-buttons">
                        <a href="/login" data-cta="intro_login" class="inline-flex items-center justify-center h-9 px-4 py-2 bg-orange-600 hover:bg-orange-700 text-white text-sm font-medium rounded-md transition-colors text-center">
                            Login
                        </a>
                        <a href="/signup" data-cta="intro_signup" class="inline-flex items-center justify-center h-9 px-4 py-2 bg-gray-700 hover:bg-gray-600 text-gray-200 text-sm font-medium rounded-md border border-gray-600 transition-colors text-center">
                            Sign up
                        </a>
                    </div>

                    <!-- Account note: below the buttons on desktop; on mobile it stays at the
                         bottom of the card, just after the intro text (order-3 in both). -->
                    <p class="text-gray-300 mb-2 text-left text-lg leading-relaxed landing-intro-note">
                        Create a free account to get started.<br>
                        (no credit card needed for free accounts)
                    </p>
                </div>
            </div>
        </div>

    </div>

    <!-- ===== Feature sections (scroll storytelling) ===== -->
    <div class="landing-features">

        <!-- Autocreate chord charts (media right) -->
        <section class="feature feature--plain" style="border-top:none">
            <div class="feature__row">
                <div class="feature__copy" data-reveal>
                    <div class="eyebrow">Less setup, more practice</div>
                    <h2>Autocreate chord charts</h2>
                    <p>Paste a link to a YouTube how-to-play video, upload a PDF or image of chord charts, or just type the chord names. We'll build your chord charts for you, and you can edit them as needed.</p>
                    <a class="cta-arrow" href="/signup" data-cta="autocreate">See it in action <span>&rarr;</span></a>
                </div>
                <div class="feature__media" data-reveal data-reveal-delay="90">
                    <div class="frame"><div class="frame__body">
                        <img src="{{ url_for('static', filename='images/tour/ChartsFromYouTubeURL.gif') }}" alt="Autocreating chord charts from a YouTube link" loading="lazy">
                    </div></div>
                </div>
            </div>
        </section>

        <!-- Build practice items (media left) -->
        <section class="feature feature--tinted">
            <div class="feature__row reverse">
                <div class="feature__copy" data-reveal>
                    <div class="eyebrow">Practice items</div>
                    <h2>Build practice items</h2>
                    <p>Songs, exercises, reminders. Each with chord charts, a field for notes, and a path to your local folders for easy copy/paste access to files on your computer.</p>
                    <a class="cta-arrow" href="/signup" data-cta="build_items">Start building <span>&rarr;</span></a>
                </div>
                <div class="feature__media" data-reveal data-reveal-delay="90">
                    <div class="frame"><div class="frame__body">
                        <video autoplay muted loop playsinline preload="metadata">
                            <source src="{{ url_for('static', filename='images/tour/CreateItem.mp4') }}" type="video/mp4">
                        </video>
                    </div></div>
                </div>
            </div>
        </section>

        <!-- Organize with routines (media right) -->
        <section class="feature feature--plain">
            <div class="feature__row">
                <div class="feature__copy" data-reveal>
                    <div class="eyebrow">Routines</div>
                    <h2>Organize with routines</h2>
                    <p>Group your items into focused routines, for working on different things in different practice sessions.</p>
                    <a class="cta-arrow" href="/signup" data-cta="organize_routines">Make a routine <span>&rarr;</span></a>
                </div>
                <div class="feature__media" data-reveal data-reveal-delay="90">
                    <div class="frame"><div class="frame__body">
                        <video autoplay muted loop playsinline preload="metadata">
                            <source src="{{ url_for('static', filename='images/tour/CreateRoutine.mp4') }}" type="video/mp4">
                        </video>
                    </div></div>
                </div>
            </div>
        </section>

        <!-- Add items to a routine (media left) -->
