<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Resubscribed - Guitar Practice Routine App</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="icon" type="image/png" sizes="48x48" href="/static/images/favicon-48x48.png">
    <link rel="apple-touch-icon" sizes="192x192" href="/static/images/GPRA-192x192.png">
    <link rel="stylesheet" href="{{ url_for('static', filename='dist/css/main.css') }}?v={{ asset_version }}">
    <link rel="stylesheet" href="{{ url_for('static', filename='css/CookieConsent.css') }}?v={{ asset_version }}">
    <script>
        // Apply theme immediately to prevent flash (light-mode system)
        (function() {
            if (localStorage.getItem('lightMode') === 'true') {
                document.documentElement.classList.add('light-mode');
                document.documentElement.classList.remove('dark');
            }
        })();
    </script>
    <!-- PostHog Analytics (shared partial) -->
    {% include "_posthog_init.html.jinja" %}

    <style>
        .theme-toggle {
            position: fixed;
            top: 20px;
            left: 20px;
            opacity: 0.6;
            transition: opacity 0.2s;
            z-index: 1000;
            cursor: pointer;
        }
        .theme-toggle:hover {
            opacity: 1.0;
        }
    </style>
</head>
<body class="bg-gray-900 show-ph-widget">
    <!-- App Title Banner -->
    <header class="bg-gray-800 border-b border-gray-700 sticky top-0 z-50">
        <div class="max-w-4xl mx-auto px-4 py-4 flex items-center justify-between">
            <a href="/" class="flex items-center gap-3 hover:opacity-80 transition-opacity">
                <span class="text-3xl">🎸</span>
                <span class="text-xl font-semibold text-white">Guitar Practice Routine App</span>
            </a>
            <nav class="flex gap-4 text-sm">
                <a href="/about" class="text-gray-400 hover:text-white transition-colors">About</a>
                <a href="/faq" class="text-gray-400 hover:text-white transition-colors">Help</a>
                <a href="/pricing" class="text-gray-400 hover:text-white transition-colors">Pricing</a>
                <a href="/terms" class="text-gray-400 hover:text-white transition-colors">Terms</a>
                <a href="/privacy" class="text-gray-400 hover:text-white transition-colors">Privacy</a>
            </nav>
        </div>
    </header>

    <div class="max-w-4xl mx-auto px-4 py-8">
        {% if success %}
        <!-- Success Message -->
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-8 text-center">
            <div class="text-5xl mb-4">✅</div>
            <h1 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">You've been resubscribed</h1>
            <p class="text-gray-700 dark:text-gray-300 mb-6">
                You will now receive inactivity reminder emails from Guitar Practice Routine App.
            </p>
            <p class="text-sm text-gray-600 dark:text-gray-400 mb-8">
                If you'd like to manage other account settings, you can log in below.
            </p>
            <a href="/login"
               class="inline-block px-6 py-3 bg-orange-600 hover:bg-orange-700 text-white rounded-md transition-colors">
                Log in to GPRA
            </a>
        </div>
        {% elif error == 'expired' %}
        <!-- Token Expired -->
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-8 text-center">
            <div class="text-5xl mb-4">⏰</div>
            <h1 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">Link expired</h1>
            <p class="text-gray-700 dark:text-gray-300 mb-6">
                This resubscribe link has expired. Please log in to manage your email preferences.
            </p>
            <a href="/login"
               class="inline-block px-6 py-3 bg-orange-600 hover:bg-orange-700 text-white rounded-md transition-colors">
                Log in to GPRA
            </a>
        </div>
        {% elif error == 'invalid' %}
        <!-- Invalid Token -->
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-8 text-center">
            <div class="text-5xl mb-4">❌</div>
            <h1 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">Invalid link</h1>
            <p class="text-gray-700 dark:text-gray-300 mb-6">
                This resubscribe link is invalid. Please check the link in your email or log in to manage your preferences.
            </p>
            <a href="/login"
               class="inline-block px-6 py-3 bg-orange-600 hover:bg-orange-700 text-white rounded-md transition-colors">
                Log in to GPRA
            </a>
        </div>
        {% elif error == 'not_found' %}
        <!-- User Not Found -->
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-8 text-center">
            <div class="text-5xl mb-4">🔍</div>
            <h1 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">Account not found</h1>
            <p class="text-gray-700 dark:text-gray-300 mb-6">
                We couldn't find an account associated with this link. The account may have been deleted.
            </p>
            <a href="/"
               class="inline-block px-6 py-3 bg-orange-600 hover:bg-orange-700 text-white rounded-md transition-colors">
                Go to GPRA
            </a>
        </div>
        {% else %}
        <!-- Generic Error -->
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-8 text-center">
            <div class="text-5xl mb-4">⚠️</div>
            <h1 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">Something went wrong</h1>
            <p class="text-gray-700 dark:text-gray-300 mb-6">
                We couldn't process your resubscribe request. Please try again or log in to manage your preferences.
            </p>
            <a href="/login"
               class="inline-block px-6 py-3 bg-orange-600 hover:bg-orange-700 text-white rounded-md transition-colors">
                Log in to GPRA
            </a>
        </div>
        {% endif %}

        <!-- Footer Links -->
        <div class="text-center text-sm text-gray-600 dark:text-gray-400 py-8 border-t border-gray-200 dark:border-gray-700 mt-8">
            <a href="/" class="hover:underline">Back to GPRA</a>
            ·
            <a href="/find-a-chord-chart" class="hover:underline">Find a chord chart</a>
            ·
            <a href="/about" class="hover:underline">About</a>
            ·
            <a href="/faq" class="hover:underline">Help</a>
            ·
            <a href="/pricing" class="hover:underline">Pricing</a>
            ·
            <a href="/terms" class="hover:underline">Terms</a>
            ·
            <a href="/privacy" class="hover:underline">Privacy</a>
        </div>
    </div>

    <!-- Theme Toggle -->
    <div class="theme-toggle" onclick="toggleTheme()" title="Toggle light/dark mode">
        <img id="light-mode-toggle"
             src="{{ url_for('static', filename='images/lightmodetoggle.png') }}"
             alt="Switch to Light Mode"
             style="height: 20px; width: 40px; display: block;">
        <img id="dark-mode-toggle"
             src="{{ url_for('static', filename='images/darkmodetoggle.png') }}"
             alt="Switch to Dark Mode"
             style="height: 20px; width: 40px; display: none;">
    </div>

    <script src="{{ url_for('static', filename='js/theme-toggle.js') }}?v={{ asset_version }}"></script>

    {% include '_cookie_consent_banner.html.jinja' %}
</body>
</html>
